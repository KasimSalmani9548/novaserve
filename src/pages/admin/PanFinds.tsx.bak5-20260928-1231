import { useEffect, useMemo, useState } from 'react';
import { api } from '../../lib/api';
import { Card, Spinner, Empty, Input, Badge, Btn, Modal, Label, formatDate } from '../../components/ui';
import { Pagination } from '../../components/Pagination';

export function AdminPanFinds() {
  const [items, setItems] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [q, setQ] = useState('');
  const [editing, setEditing] = useState<any>(null);
  const [pan, setPan] = useState('');
  const [name, setName] = useState('');
  const [status, setStatus] = useState('ACTIVE');
  const [note, setNote] = useState('');
  const [busy, setBusy] = useState(false);
  const [confirmOpen, setConfirmOpen] = useState(false);
  const [page, setPage] = useState(1);
  const [perPage, setPerPage] = useState(10);

  const load = () => api.get('/pan/history').then((d) => setItems(Array.isArray(d) ? d : [])).finally(() => setLoading(false));
  useEffect(() => { load(); }, []);

  const filtered = useMemo(() => items.filter((p) => p.status !== 'PENDING').filter((p) =>
    !q || (p.userName || '').toLowerCase().includes(q.toLowerCase()) || (p.aadhaar || '').includes(q)
  ), [items, q]);

  const paged = filtered.slice((page - 1) * perPage, page * perPage);

  const doDelete = async (id: string) => { if (!confirm('Delete this PAN Find request permanently?')) return; try { await api.del('/pan/requests/' + id); await load(); } catch (e: any) { alert(e.message); } };
  const openEdit = (item: any) => {
    setEditing(item); setPan(item.pan || ''); setName(item.nameOnPan || '');
    setStatus(item.panStatus || 'ACTIVE'); setNote(item.note || '');
  };

  const save = async () => {
    setBusy(true);
    try {
      await api.put(`/pan/requests/${editing.id}`, { pan, nameOnPan: name, panStatus: status, note });
      setEditing(null); await load();
    } catch (e: any) { alert(e.message); }
    finally { setBusy(false); }
  };

  const doReject = async (refund: boolean) => {
    setBusy(true);
    try {
      await api.put(`/pan/requests/${editing.id}`, { status: 'REJECTED', note: note || 'Rejected by admin', refund });
      setConfirmOpen(false); setEditing(null); await load();
    } catch (e: any) { alert(e.message); }
    finally { setBusy(false); }
  };

  if (loading) return <div className="flex justify-center py-20"><Spinner className="text-emerald-500" /></div>;

  return (
    <div className="space-y-5">
      <h1 className="text-2xl font-bold text-slate-100">PAN Find Requests</h1>
      <Input value={q} onChange={(e) => { setQ(e.target.value); setPage(1); }} placeholder="Search by customer or Aadhaar..." />
      <Card>
        {filtered.length === 0 ? <Empty title="No requests" /> : (
          <>
            <div className="overflow-x-auto">
              <table className="w-full text-sm">
                <thead className="text-slate-500 text-xs bg-slate-950/50">
                  <tr>
                    <th className="text-left p-3">Date</th>
                    <th className="text-left p-3">Customer</th>
                    <th className="text-left p-3">Aadhaar</th>
                    <th className="text-left p-3">PAN</th>
                    <th className="text-left p-3">Name</th>
                    <th className="text-left p-3">Status</th>
                    <th className="text-right p-3">Action</th>
                  </tr>
                </thead>
                <tbody>
                  {paged.map((p) => (
                    <tr key={p.id} className="border-t border-slate-800">
                      <td className="p-3 text-slate-400 text-xs">{formatDate(p.createdAt)}</td>
                      <td className="p-3 text-slate-200">{p.userName}</td>
                      <td className="p-3 font-mono text-xs text-slate-400">XXXX XXXX {(p.aadhaar || '').slice(-4)}</td>
                      <td className="p-3 font-mono text-slate-200">{p.pan || 'â€”'}</td>
                      <td className="p-3 text-slate-300">{p.nameOnPan || 'â€”'}</td>
                      <td className="p-3">
                        <Badge tone={p.status === 'APPROVED' ? 'green' : p.status === 'REJECTED' ? 'red' : 'yellow'}>
                          {p.status || 'PENDING'}
                        </Badge>
                      </td>
                      <td className="p-3 text-right">
                        <button onClick={() => openEdit(p)} className="text-emerald-400 text-xs hover:underline">Manage</button>
                        <button onClick={() => doDelete(p.id)} className="text-rose-400 text-xs hover:underline ml-2">Delete</button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <Pagination total={filtered.length} page={page} perPage={perPage} onPageChange={setPage} onPerPageChange={setPerPage} />
          </>
        )}
      </Card>

      <Modal open={!!editing} onClose={() => setEditing(null)} title="PAN Find â€” Add Result">
        {editing && (
          <div className="space-y-3">
            <div className="text-xs text-slate-400">
              <p>Customer: {editing.userName}</p>
              <p>Aadhaar: XXXX XXXX {(editing.aadhaar || '').slice(-4)}</p>
              <p className="mt-1 text-slate-300">Refund Amount: Rs {editing.charge || 15}</p>
            </div>
            <div><Label>PAN Number *</Label><Input value={pan} onChange={(e) => setPan(e.target.value.toUpperCase())} placeholder="ABCDE1234F" className="font-mono" /></div>
            <div><Label>Name on PAN</Label><Input value={name} onChange={(e) => setName(e.target.value)} /></div>
            <div>
              <Label>Status</Label>
              <select value={status} onChange={(e) => setStatus(e.target.value)} className="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-sm text-slate-100">
                <option value="ACTIVE">ACTIVE</option>
                <option value="INACTIVE">INACTIVE</option>
              </select>
            </div>
            <div><Label>Note (optional)</Label><Input value={note} onChange={(e) => setNote(e.target.value)} /></div>
            <div className="flex gap-2 pt-2">
              <Btn variant="danger" onClick={() => setConfirmOpen(true)} disabled={busy}>Reject</Btn>
              <Btn onClick={save} disabled={busy || !pan} className="flex-1">{busy ? 'Saving...' : 'Approve & Save'}</Btn>
            </div>
          </div>
        )}
      </Modal>

      {confirmOpen && editing && (
        <div className="fixed inset-0 bg-black/60 flex items-center justify-center z-[60] p-4" onClick={() => setConfirmOpen(false)}>
          <div className="bg-slate-900 border border-slate-800 rounded-xl max-w-md w-full" onClick={(e) => e.stopPropagation()}>
            <div className="p-5 border-b border-slate-800">
              <h3 className="font-semibold text-slate-100">Refund to Customer?</h3>
            </div>
            <div className="p-5 space-y-3">
              <p className="text-sm text-slate-300">
                You are about to reject PAN Find request for <span className="font-mono text-slate-400">{editing.userName}</span>.
              </p>
              <p className="text-sm text-slate-300">
                Do you want to refund <span className="font-bold text-emerald-400">Rs {editing.charge || 15}</span> to the customer's wallet?
              </p>
            </div>
            <div className="p-4 border-t border-slate-800 flex flex-col sm:flex-row gap-2">
              <Btn variant="secondary" onClick={() => setConfirmOpen(false)} disabled={busy}>Cancel</Btn>
              <Btn variant="danger" onClick={() => doReject(false)} disabled={busy} className="flex-1">No Refund - Reject Only</Btn>
              <Btn onClick={() => doReject(true)} disabled={busy} className="flex-1">Yes Refund - Reject & Credit</Btn>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
